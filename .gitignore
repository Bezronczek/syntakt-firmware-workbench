# Whitelist: ignore everything, then allow exactly what is meant to be public.
# Firmware, anything extracted from it, backups and third-party tools must never be committed.
/*
!/.gitignore
!/README.md
!/LICENSE
!/.github/
!/test-waves/
!/web/
!/tools/

# tools/: only small helpers for users. Research and test scripts stay private.
/tools/*
!/tools/din_loopback_test.py
!/tools/syntakt_os_flash.py

# web/: no mockups, no internal specs
/web/mockup*.html
/web/SPEC*.md

# belt and braces: never, anywhere
*.syx
*.zip
*.raw
*.bin
*.asm
*.npz
__pycache__/
